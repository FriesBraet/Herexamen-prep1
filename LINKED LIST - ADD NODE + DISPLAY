# TEST
# ============================================================

my_list = LinkedList()

my_list.add_node(12)
my_list.add_node(5)
my_list.add_node(8)

my_list.display()


# Structuur:
#
# head
#  |
#  v
# [12] -> [5] -> [8] -> None
#
# Output:
# 12
# 5
# 8
