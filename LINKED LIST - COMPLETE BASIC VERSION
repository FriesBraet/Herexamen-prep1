# ============================================================
# LINKED LIST - COMPLETE BASIC VERSION
# ADD - DISPLAY - FIND - TOTAL - REMOVE
# ============================================================


class Node:
    def __init__(self, value):
        # Waarde opgeslagen in de node
        self.value = value

        # Verwijzing naar volgende node
        self.next = None

    def __str__(self):
        # Bepaalt hoe de node geprint wordt
        return f"{self.value} value"


class LinkedList:
    def __init__(self):
        # Eerste node van de linked list
        # Lege lijst -> head = None
        self.head = None


    # ========================================================
    # ADD
    # Voeg nieuwe node achteraan toe
    # ========================================================

    def add(self, value):
        new_node = Node(value)

        # CASE 1: lijst is leeg
        if self.head is None:
            self.head = new_node

        # CASE 2: lijst bevat al nodes
        else:
            current = self.head

            # Zoek laatste node
            while current.next is not None:
                current = current.next

            # Voeg nieuwe node achteraan toe
            current.next = new_node


    # ========================================================
    # DISPLAY
    # Toon alle nodes
    # ========================================================

    def display(self):

        # Speciale case: lege lijst
        if self.head is None:
            print("Empty")
            return

        current = self.head

        # Doorloop volledige linked list
        while current is not None:
            print(current)
            current = current.next


    # ========================================================
    # FIND
    # Controleer of value voorkomt
    # ========================================================

    def find(self, value):
        current = self.head

        while current is not None:

            if current.value == value:
                return True

            current = current.next

        # Hele lijst doorlopen zonder resultaat
        return False


    # ========================================================
    # TOTAL
    # Bereken som van alle values
    # ========================================================

    def total(self):
        current = self.head
        total = 0

        while current is not None:

            total += current.value

            current = current.next

        return total


    # ========================================================
    # REMOVE
    # Verwijder eerste node met gegeven value
    # ========================================================

    def remove(self, value):
        current = self.head
        previous = None

        while current is not None:

            # Gezochte node gevonden
            if current.value == value:

                # CASE 1:
                # huidige node is de head
                if previous is None:
                    self.head = current.next

                # CASE 2:
                # huidige node staat ergens na de head
                else:
                    previous.next = current.next

                # Geef verwijderde node terug
                return current

            # Schuif beide pointers één plaats verder
            previous = current
            current = current.next

        # Waarde niet gevonden
        return None


# ============================================================
# TEST
# ============================================================

my_list = LinkedList()


# Lege lijst tonen
my_list.display()

# Output:
# Empty


# Nodes toevoegen
my_list.add(1)
my_list.add(3)
my_list.add(8)


# Structuur:
#
# head
#  |
#  v
# [1] -> [3] -> [8] -> None


my_list.display()

# Output:
# 1 value
# 3 value
# 8 value


# ============================================================
# FIND
# ============================================================

print(my_list.find(8))
# True

print(my_list.find(99))
# False


# ============================================================
# TOTAL
# ============================================================

print(my_list.total())

# 1 + 3 + 8 = 12


# ============================================================
# REMOVE
# ============================================================

my_list.remove(8)

# Nu:
# [1] -> [3] -> None

my_list.display()


my_list.remove(3)

# Nu:
# [1] -> None

my_list.display()
