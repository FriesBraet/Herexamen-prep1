# ============================================================
# 6. FUNCTION MET RETURN
# ============================================================

def double_number(number):
    # Geeft het dubbele van number terug
    return number * 2


double_list = []
total_doubles = 0

print(double_list)
print(total_doubles)


# Doorloop alle getallen
for number in numbers:

    # Bereken dubbele
    doubled_number = double_number(number)

    # Voeg dubbele toe aan nieuwe lijst
    double_list.append(doubled_number)

    # Tel dubbele op bij totaal
    total_doubles += doubled_number


print(
    f"De lijst van dubbels is {double_list} "
    f"en hun totale som bedraagt {total_doubles}"
)


