# ============================================================
# 1. LISTS
# ============================================================

my_list = ["f1", "f2", "f3"]

# Element ophalen via index
print(my_list[0])      # eerste element -> f1
print(my_list[-1])     # laatste element -> f3


# Element achteraan toevoegen
my_list.append("f4")
print(my_list[-1])     # f4


# Element verwijderen op basis van waarde
my_list.remove("f2")

print(my_list[1])      # f3


# Lengte van lijst
length = len(my_list)
print(length)


# Controleren of element aanwezig is
if "f4" in my_list:
    print("Yipla")
else:
    print("Nooo")


