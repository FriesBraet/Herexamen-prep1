# 2. NESTED FOR-LOOPS
# ============================================================

mini_list = ["f1", "f2"]

# Vergelijk ieder element uit my_list
# met ieder element uit mini_list
for element in my_list:
    for mini_element in mini_list:

        if element == mini_element:
            print(
                f"{element} uit my_list zit ook in mini_list"
            )


# ============================================================
# 3. FOR-LOOP DOOR EEN LIST
