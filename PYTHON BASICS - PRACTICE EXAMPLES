# 10. CLASS MET METHODS
# ============================================================

class Car:

    def __init__(self, brand, speed):
        self.brand = brand
        self.speed = speed

    def get_speed(self):
        # Geeft speed van dit object terug
        return self.speed

    def fast_or_not(self):

        if self.speed > 190:
            return "Fast"

        else:
            return "Slow"


car1 = Car("BMW", 180)
car2 = Car("Audi", 220)


print(
    f"Car 1 is a {car1.brand}, "
    f"goes {car1.get_speed()} km/h "
    f"and this is {car1.fast_or_not()}"
)


