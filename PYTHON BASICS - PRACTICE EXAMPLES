# ============================================================
# 13. NODE
# ============================================================

class Node:

    def __init__(self, value):

        self.value = value

        # Verwijzing naar volgende node
        # Initieel bestaat die nog niet
        self.next = None

    def __str__(self):

        # Laatste node heeft self.next = None.
        # Daarom moeten we eerst controleren
        # of er wel een volgende node bestaat.

        if self.next is None:
            return (
                f"Node met waarde {self.value} "
                f"heeft geen volgende node"
            )

        return (
            f"Node met waarde {self.value} "
            f"heeft als volgende node {self.next.value}"
        )


# ============================================================
# 14. LINKED LIST
# ============================================================

class LinkedList:

    def __init__(self):

        # head verwijst naar eerste node
        # Lege linked list -> head = None
        self.head = None


# Maak lege linked list
linked_list = LinkedList()

print(linked_list.head)      # None


# Maak afzonderlijke nodes
node1 = Node(10)
node2 = Node(20)
node3 = Node(30)


# Eerste node wordt head
linked_list.head = node1


# Nodes met elkaar verbinden

node1.next = node2
node2.next = node3

# Structuur:
#
# head
#  |
#  v
# [10] -> [20] -> [30] -> None


# ============================================================
# 15. LINKED LIST DOORLOPEN
# ============================================================

current = linked_list.head

# Start bij eerste node
# en ga verder zolang current bestaat

while current is not None:

    print(current.value)

    # Ga naar volgende node
    current = current.next


# Output:
# 10
# 20
# 30
